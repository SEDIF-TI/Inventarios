# =====================================================
# GENERAL
# =====================================================
PROJECT_NAME=mi-proyecto

# Perfil de Spring activo (dev en local, prod en servidor)
SPRING_PROFILE=dev

# =====================================================
# BASE DE DATOS (Postgres)
# =====================================================
DB_URL=jdbc:postgresql://localhost:5433/db_inventario
DB_USERNAME=postgres
DB_PASSWORD=changeme

# =====================================================
# BACKEND (Spring Boot)
# =====================================================
# Secreto para firmar los JWT — genera uno largo y aleatorio,
# por ejemplo con: openssl rand -base64 64
JWT_SECRET=changeme-genera-uno-largo-y-aleatorio
SPRING_PROFILE=dev

# =====================================================
# FRONTEND (React + Vite)
# =====================================================
# URL base que el frontend usa para llamar a la API.
# En local normalmente apunta directo al backend.
# En prod se usa "/api" porque el reverse proxy lo redirige.
VITE_API_URL=http://localhost:8080/api